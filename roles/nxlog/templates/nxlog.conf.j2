## NXLog Linux Configuration - using GELF to send the logs to Alloy
## Generated by Ansible on {{ ansible_date_time.iso8601 }}
## Made by Gabriel TORDJMAN and DeepSeek AI - 2026
## This configuration is used with the "Grafana-CPLEM" project
## Host: {{ ansible_hostname }}
## OS: {{ ansible_distribution }} {{ ansible_distribution_version }}
define ROOT /usr

Moduledir %ROOT%/lib/nxlog/modules
CacheDir   {{ nxlog_cache_dir | default('/var/lib/nxlog/data') }}
Pidfile    {{ nxlog_pidfile | default('/var/run/nxlog/nxlog.pid') }}
SpoolDir   {{ nxlog_spooldir | default('/var/lib/nxlog/data') }}
LogFile    {{ nxlog_logfile | default('/var/log/nxlog/nxlog.log') }}
LogLevel   {{ nxlog_log_level | default('INFO') }}

########################
# EXTENSIONS
########################

<Extension syslog>
    Module xm_syslog
</Extension>

<Extension gelf>
    Module xm_gelf
</Extension>

########################
# INPUTS
########################

<Input kernel>
    Module im_kernel
</Input>

<Input systemd>
    Module im_systemd
</Input>

<Input ssh_auth>
    Module im_file
    File "{{ ssh_auth_log | default('/var/log/auth.log') }}"
    ReadFromLast TRUE
    SavePos TRUE
</Input>

{% if additional_inputs is defined %}
{# Additional inputs from variables #}
{% for input in additional_inputs %}
<Input {{ input.name }}>
    Module {{ input.module }}
    {% for key, value in input.params.items() %}
    {{ key }} {{ value }}
    {% endfor %}
</Input>
{% endfor %}
{% endif %}

########################
# PROCESSOR
########################

<Processor add_ip>
    Module pm_transformer
    Exec $ip_address = "{{ nxlog_host_ip }}";
</Processor>

########################
# OUTPUT
########################

<Output graylog_udp>
    Module om_udp
    Host {{ graylog_server_ip | default('192.168.1.207') }}
    Port {{ graylog_server_port | default('12201') }}
    OutputType GELF_UDP
</Output>

########################
# ROUTE
########################

<Route r>
    Path kernel, systemd, ssh_auth{% if additional_inputs is defined %}{% for input in additional_inputs %}, {{ input.name }}{% endfor %}{% endif %} => add_ip => graylog_udp
</Route>